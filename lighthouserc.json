{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3000",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3000/?nointro",
        "http://localhost:3000/work/first-table?nointro"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "throttlingMethod": "devtools"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/work/",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500,
                "aggregationMethod": "median-run"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1,
                "aggregationMethod": "median-run"
              }
            ],
            "uses-responsive-images": [
              "error",
              {
                "minScore": 1
              }
            ],
            "modern-image-formats": [
              "error",
              {
                "minScore": 1
              }
            ],
            "offscreen-images": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/\\?nointro$",
          "assertions": {
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 2500,
                "aggregationMethod": "median-run"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1,
                "aggregationMethod": "median-run"
              }
            ],
            "uses-responsive-images": [
              "warn",
              {
                "minScore": 1
              }
            ],
            "modern-image-formats": [
              "warn",
              {
                "minScore": 1
              }
            ],
            "offscreen-images": [
              "warn",
              {
                "minScore": 1
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
