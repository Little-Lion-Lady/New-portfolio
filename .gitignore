# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.skill

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# source media kept locally — only the exported .mp4/.jpg are committed
public/**/*.mov
public/home/work/firsttable/Screenshots.jpg

# agent skills — installed per-machine with `npx skills add`, kept out of the
# repo so they can be updated independently of the site
/.agents/
/.claude/skills/
/skills-lock.json

# Pre-crop copies of the exports that shipped with a light 1px edge
.image-originals/
